# Copy to .env.settings and fill in real values. Never commit .env.settings.

ENVIRONMENT=development
AUTO_CREATE_TABLES=true

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=edabip_user
DB_PASSWORD=change_me
DB_NAME=edabip_settings

# --- The auth backend's credential store (see app/core/auth_credentials.py) ---
# The password a user signs in with lives in the AUTH backend's database, not
# in DB_NAME above — the two services currently run on separate schemas. The
# settings service reads/writes users.password_hash there so "Change Password"
# updates the credential login actually checks. AUTH_DB_NAME is the auth
# backend's database (the api service's DB_NAME); AUTH_DATABASE_URL_RAW
# overrides the whole URL if it lives on a different server.
AUTH_DB_NAME=edabip
# AUTH_DATABASE_URL_RAW=mysql+pymysql://user:pass@host:3306/edabip

# --- Standalone JWT stub (see app/core/security.py) ---
# Ignored once this module is merged into the main EDABIP app's auth system.
# Generate a real value for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY must equal the auth backend's JWT_SECRET_KEY
JWT_SECRET_KEY=changeme-generate-a-real-secret
JWT_ALGORITHM=HS256

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS_RAW=http://localhost:5173,http://localhost:3000
