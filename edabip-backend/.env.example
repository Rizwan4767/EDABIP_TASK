# ── Application ────────────────────────────────────────────────
APP_NAME=EDABIP API
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
EXPOSE_DOCS=true
FRONTEND_URL=http://localhost:5173
# Optional LAN SPA URL for phones (auto-detected from localhost if unset).
# FRONTEND_MOBILE_URL=http://192.168.1.20:5173
# Optional public API URL for reset-email landing page (auto-detected if unset).
# API_PUBLIC_URL=http://192.168.1.20:8000
# Expo app scheme + Android package for deep links in reset emails.
MOBILE_APP_SCHEME=edabip-dev
MOBILE_APP_PACKAGE=com.edabip.mobile.dev
# Optional comma-separated list, e.g. http://192.168.1.20:8081 for Expo web on LAN
# CORS_EXTRA_ORIGINS=

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://root:12345@localhost:3306/edabip

# ── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-secret-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth2 ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Microsoft / Azure AD SSO ────────────────────────────────────
# Register an app at https://portal.azure.com → App registrations
# Set the redirect URI to your frontend origin (MSAL handles the callback in-browser).
# The backend only needs CLIENT_ID (and optionally TENANT_ID) to verify idTokens.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common   # Use 'common' for multi-tenant, or your tenant GUID
MICROSOFT_CLIENT_SECRET=     # Only needed for confidential-client flows (not MSAL SPA)

# ── Email / SMTP ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=EDABIP

# ── Security ──────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60
MAX_PASSWORD_LENGTH=72

# ── Razorpay / Billing ───────────────────────────────────────────
# Test-mode keys from https://dashboard.razorpay.com/app/keys
# Keep using rzp_test_ until you are ready to take live payments.
# The xxxx placeholders below are NOT valid — replace both values or
# "+ Add New Payment Method" will fail with a Razorpay auth error.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Register https://yourdomain.com/api/billing/webhooks/razorpay in the
# Razorpay Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_CARD_VERIFICATION_AMOUNT=100

# Saving a card needs Razorpay to mint a token, and tokenisation is gated
# behind completed KYC. On a test account that cannot be KYC'd, the
# verification payment is captured but no token comes back. With a
# rzp_test_ key the backend still saves brand/last4 as a NON-CHARGEABLE
# row so the card appears in the list. Live keys (rzp_live_) never take
# that path — they require a real token.
#
# BILLING_ALLOW_TEST_CARD_FALLBACK is kept for compatibility; test-mode
# fallback is automatic. Plan charging still rejects non-chargeable cards.
BILLING_ALLOW_TEST_CARD_FALLBACK=true
BILLING_GRACE_PERIOD_DAYS=7
BILLING_USAGE_WARNING_PCT=80
BILLING_USAGE_CRITICAL_PCT=95
BILLING_DEFAULT_CURRENCY=inr
BILLING_EXPIRY_ALERT_DAYS=5

# Seller printed on GST tax invoices (Issued by). Override with the live
# legal entity before production. Buyer details are per-org and editable
# in Billing → Billed to.
BILLING_SELLER_LEGAL_NAME=STACKLY Pvt Ltd
BILLING_SELLER_ADDRESS_LINE1=#42, 3rd Floor, Indiranagar
BILLING_SELLER_CITY=Bengaluru
BILLING_SELLER_STATE=Karnataka
BILLING_SELLER_STATE_CODE=29
BILLING_SELLER_PINCODE=560038
BILLING_SELLER_COUNTRY=India
BILLING_SELLER_GSTIN=29AABCE1234F1Z5
BILLING_SELLER_EMAIL=accounts@edabip.com
# After first boot, seed catalog plans + org_id=1 demo billing data:
#   cd edabip-backend && python -m billing.seed_demo
# (seed_demo also runs seed_plans and creates user@edabip.com / User@123)
#
# Shared local logins from `python seed.py` (not created in production):
#   admin@example.com / Admin@123   admin — can add cards / change plans
#   user@edabip.com   / User@123    client_user — billing view-only

# --- Reports module -----------------------------------------------------------
# Scheduled reports are executed by `python -m services.report_scheduler` (cron,
# recommended) or, on a SINGLE-instance deployment, by an in-process loop:
REPORT_SCHEDULER_ENABLED=false
REPORT_SCHEDULER_POLL_SECONDS=60
# Run nightly from cron: python -m services.report_maintenance
REPORT_ARCHIVE_AFTER_DAYS=90
REPORT_PURGE_FILES_AFTER_DAYS=365
REPORT_STUCK_AFTER_MINUTES=30
