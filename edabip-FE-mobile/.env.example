# EDABIP mobile — environment template.
# Copy to `.env` for local development. Never commit a real `.env`.
#
# Only EXPO_PUBLIC_* variables are readable by the app at runtime. Everything
# prefixed with EXPO_PUBLIC_ is embedded in the JavaScript bundle and is
# therefore PUBLIC. Never place secrets, private keys, or client secrets here.

# One of: development | testing | production
# Also selects the app name, bundle identifier, and deep-link scheme.
EXPO_PUBLIC_APP_ENV=development

# Base URL of the existing EDABIP FastAPI backend (no trailing slash, no /api prefix).
# In development, localhost/127.0.0.1 is rewritten to Metro's host IP automatically
# so physical devices can reach your machine without editing this every time.
# Override with an explicit LAN URL only when auto-detection does not work.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Verbose network/auth logging. Keep false for testing and production builds.
EXPO_PUBLIC_ENABLE_DEV_LOGGING=true

EAS_SKIP_AUTO_FINGERPRINT=1