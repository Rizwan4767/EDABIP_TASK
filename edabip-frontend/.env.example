VITE_API_BASE_URL=http://localhost:8000

# When true (and running vite in DEV), login/signup use the local mock flow
# (mock users + OTP 1234) instead of the FastAPI backend.
# Set to false to hit the real backend at VITE_API_BASE_URL.
VITE_ENABLE_MOCK_AUTH=false

VITE_ENABLE_MOCK_EMAIL_VERIFICATION=true
VITE_USE_MOCK_LOCALE_PREFERENCES=true

# Microsoft Entra ID (production). Never put a client secret in the SPA.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common
VITE_MICROSOFT_REDIRECT_URI=

# Settings routes are served by the main API. Keep this aligned with
# VITE_API_BASE_URL.
VITE_SETTINGS_API_BASE_URL=http://127.0.0.1:8000

# true = use the in-browser settings mock instead of the API (dev only).
VITE_ENABLE_MOCK_SETTINGS=false
